# ========================================
# AWS基本設定
# ========================================
aws_region = "ap-northeast-1"

# ========================================
# プロジェクト設定
# ========================================
project_name = "album-battler"
environment  = "production"

# ========================================
# S3設定（画像ストレージ）
# ========================================
s3_bucket_name        = "album-battler-images"  # グローバルで一意の名前が必要
s3_enable_versioning  = true
s3_allowed_origins    = ["*"]  # テスト用

# ========================================
# VPC設定
# ========================================
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["ap-northeast-1a", "ap-northeast-1c"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]

# ========================================
# RDS設定（MySQL）
# ========================================
db_name                     = "album_battler"
db_username                 = "album_user"
db_password                 = "CHANGE_ME_SECURE_PASSWORD"  # 必ず変更してください！
rds_instance_class          = "db.t4g.micro"              # 月額 ~$12
rds_allocated_storage       = 20                          # GB
rds_multi_az                = false                       # true にするとコスト2倍
rds_skip_final_snapshot     = true                        # 本番環境では false 推奨
rds_backup_retention_period = 7                           # 日数

# ========================================
# ECS設定（Fargate Spot）
# ========================================
ecs_log_retention_days = 7

# Frontend（Next.js）
frontend_cpu           = "512"   # 0.5 vCPU
frontend_memory        = "1024"  # 1 GB
frontend_desired_count = 1       # タスク数

# Backend（Go）
backend_cpu           = "1024"  # 1 vCPU
backend_memory        = "2048"  # 2 GB
backend_desired_count  = 1      # タスク数

# ========================================
# API Keys
# ========================================
gemini_api_key = "YOUR_GEMINI_API_KEY_HERE"  # 必ず設定してください！

# ========================================
# Route 53 & カスタムドメイン設定
# ========================================
enable_route53 = true
domain_name    = "albumbattler.com"