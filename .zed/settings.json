{
  "tab_size": 2,
  "hard_tabs": false,
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "formatter": {
    "external": {
      "command": "sh",
      "arguments": [
        "-c",
        "cd frontend && npm exec -- prettier --stdin-filepath {buffer_path}"
      ]
    }
  },
  "languages": {
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": false
      }
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.eslint": false
      }
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": false
      }
    },
    "Go": {
      "formatter": "language_server"
    }
  },
  "lsp": {
    "eslint": {
      "settings": {
        "workingDirectory": {
          "mode": "auto"
        }
      }
    }
  }
}
